{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "msc-outside-monitor event v1",
  "type": "object",
  "required": ["type", "record_index", "chain"],
  "oneOf": [
    {
      "required": [
        "protocol",
        "schema_version",
        "source",
        "sequence",
        "timestamp",
        "session_id",
        "type_id",
        "flags",
        "status",
        "category",
        "outside_client",
        "attribution",
        "value0",
        "value1",
        "operation_id",
        "text",
        "detail",
        "component"
      ]
    },
    {
      "properties": {
        "type": {"enum": ["observer_sequence_gap", "observer_summary"]}
      }
    }
  ],
  "properties": {
    "protocol": {"type": "integer", "minimum": 1},
    "schema_version": {"const": 1},
    "source": {"type": "string", "enum": ["driver", "etw", "agent"]},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "session_id": {"type": "integer", "minimum": 0},
    "type": {"type": "string"},
    "type_id": {"type": "integer", "minimum": 0},
    "process_id": {"type": "integer", "minimum": 0},
    "process_start_time": {"type": "integer", "minimum": 0},
    "process_path": {"type": "string"},
    "parent_process_id": {"type": "integer", "minimum": 0},
    "thread_id": {"type": "integer", "minimum": 0},
    "target_process_id": {"type": "integer", "minimum": 0},
    "target_process_start_time": {"type": "integer", "minimum": 0},
    "flags": {"type": "integer", "minimum": 0},
    "flags_names": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "integer"},
    "status_name": {"type": "string"},
    "status_hex": {"type": "string", "pattern": "^0x[0-9A-F]{8}$"},
    "desired_access": {"type": "integer", "minimum": 0},
    "desired_access_hex": {"type": "string", "pattern": "^0x[0-9A-F]{8}$"},
    "category": {
      "type": "string",
      "enum": [
        "unknown", "client_data", "windows_runtime", "external_process",
        "browser_interaction", "hardware_identity", "user_data", "registry",
        "network", "ipc"
      ]
    },
    "outside_client": {"type": "boolean"},
    "attribution": {
      "type": "string",
      "enum": ["unknown", "process_only", "stack_resolved", "service_correlated", "static_evidence"]
    },
    "value0": {"type": "integer"},
    "value1": {"type": "integer"},
    "operation_id": {"type": "integer", "minimum": 0},
    "text": {"type": "string"},
    "detail": {"type": "string"},
    "component": {"type": "string"},
    "modules": {"type": "array", "items": {"type": "string"}},
    "payload_unavailable": {"type": "boolean"},
    "payload": {
      "type": "object",
      "required": ["kind", "encoding", "data", "operation_id", "total_bytes", "byte_offset", "chunk_index", "chunk_count", "final_chunk"],
      "properties": {
        "kind": {"type": "string"},
        "encoding": {"const": "base64"},
        "data": {"type": "string"},
        "operation_id": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "byte_offset": {"type": "integer", "minimum": 0},
        "chunk_index": {"type": "integer", "minimum": 0},
        "chunk_count": {"type": "integer", "minimum": 1},
        "final_chunk": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "record_index": {"type": "integer", "minimum": 1},
    "chain": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
